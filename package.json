{
    "name": "@modelcontextprotocol/sdk",
    "version": "2.0.0-alpha.0",
    "description": "Model Context Protocol implementation for TypeScript",
    "license": "SEE LICENSE IN LICENSE",
    "author": "Model Context Protocol a Series of LF Projects, LLC.",
    "homepage": "https://modelcontextprotocol.io",
    "bugs": "https://github.com/modelcontextprotocol/typescript-sdk/issues",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/modelcontextprotocol/typescript-sdk.git"
    },
    "engines": {
        "node": ">=20"
    },
    "packageManager": "pnpm@10.26.1",
    "keywords": [
        "modelcontextprotocol",
        "mcp"
    ],
    "exports": {
        ".": {
            "types": "./packages/client/src/index.ts",
            "import": "./packages/client/src/index.ts",
            "default": "./packages/client/src/index.ts"
        },
        "./client": {
            "types": "./packages/client/src/index.ts",
            "import": "./packages/client/src/index.ts",
            "default": "./packages/client/src/index.ts"
        },
        "./client/index": {
            "types": "./packages/client/src/index.ts",
            "import": "./packages/client/src/index.ts",
            "default": "./packages/client/src/index.ts"
        },
        "./client/index.js": {
            "types": "./packages/client/src/index.ts",
            "import": "./packages/client/src/index.ts",
            "default": "./packages/client/src/index.ts"
        },
        "./client/client": {
            "types": "./packages/client/src/client/client.ts",
            "import": "./packages/client/src/client/client.ts",
            "default": "./packages/client/src/client/client.ts"
        },
        "./client/client.js": {
            "types": "./packages/client/src/client/client.ts",
            "import": "./packages/client/src/client/client.ts",
            "default": "./packages/client/src/client/client.ts"
        },
        "./client/streamableHttp": {
            "types": "./packages/client/src/client/streamableHttp.ts",
            "import": "./packages/client/src/client/streamableHttp.ts",
            "default": "./packages/client/src/client/streamableHttp.ts"
        },
        "./client/streamableHttp.js": {
            "types": "./packages/client/src/client/streamableHttp.ts",
            "import": "./packages/client/src/client/streamableHttp.ts",
            "default": "./packages/client/src/client/streamableHttp.ts"
        },
        "./client/sse": {
            "types": "./packages/client/src/client/sse.ts",
            "import": "./packages/client/src/client/sse.ts",
            "default": "./packages/client/src/client/sse.ts"
        },
        "./client/sse.js": {
            "types": "./packages/client/src/client/sse.ts",
            "import": "./packages/client/src/client/sse.ts",
            "default": "./packages/client/src/client/sse.ts"
        },
        "./client/stdio": {
            "types": "./packages/client/src/client/stdio.ts",
            "import": "./packages/client/src/client/stdio.ts",
            "default": "./packages/client/src/client/stdio.ts"
        },
        "./client/stdio.js": {
            "types": "./packages/client/src/client/stdio.ts",
            "import": "./packages/client/src/client/stdio.ts",
            "default": "./packages/client/src/client/stdio.ts"
        },
        "./client/auth": {
            "types": "./packages/client/src/client/auth.ts",
            "import": "./packages/client/src/client/auth.ts",
            "default": "./packages/client/src/client/auth.ts"
        },
        "./client/auth.js": {
            "types": "./packages/client/src/client/auth.ts",
            "import": "./packages/client/src/client/auth.ts",
            "default": "./packages/client/src/client/auth.ts"
        },
        "./server": {
            "types": "./packages/server/src/index.ts",
            "import": "./packages/server/src/index.ts",
            "default": "./packages/server/src/index.ts"
        },
        "./server/index": {
            "types": "./packages/server/src/index.ts",
            "import": "./packages/server/src/index.ts",
            "default": "./packages/server/src/index.ts"
        },
        "./server/index.js": {
            "types": "./packages/server/src/index.ts",
            "import": "./packages/server/src/index.ts",
            "default": "./packages/server/src/index.ts"
        },
        "./types": {
            "types": "./packages/core/src/types/index.ts",
            "import": "./packages/core/src/types/index.ts",
            "default": "./packages/core/src/types/index.ts"
        },
        "./types.js": {
            "types": "./packages/core/src/types/index.ts",
            "import": "./packages/core/src/types/index.ts",
            "default": "./packages/core/src/types/index.ts"
        },
        "./types/schemas": {
            "types": "./packages/core/src/types/schemas.ts",
            "import": "./packages/core/src/types/schemas.ts",
            "default": "./packages/core/src/types/schemas.ts"
        },
        "./types/schemas.js": {
            "types": "./packages/core/src/types/schemas.ts",
            "import": "./packages/core/src/types/schemas.ts",
            "default": "./packages/core/src/types/schemas.ts"
        },
        "./shared/auth": {
            "types": "./packages/core/src/shared/auth.ts",
            "import": "./packages/core/src/shared/auth.ts",
            "default": "./packages/core/src/shared/auth.ts"
        },
        "./shared/auth.js": {
            "types": "./packages/core/src/shared/auth.ts",
            "import": "./packages/core/src/shared/auth.ts",
            "default": "./packages/core/src/shared/auth.ts"
        }
    },
    "files": [
        "packages/core/src",
        "packages/client/src",
        "packages/server/src"
    ],
    "scripts": {
        "fetch:spec-types": "tsx scripts/fetch-spec-types.ts",
        "sync:snippets": "tsx scripts/sync-snippets.ts",
        "examples:simple-server:w": "pnpm --filter @modelcontextprotocol/examples-server exec tsx --watch src/simpleStreamableHttp.ts --oauth",
        "docs": "typedoc",
        "docs:multi": "bash scripts/generate-multidoc.sh",
        "docs:check": "typedoc",
        "typecheck:all": "pnpm -r typecheck",
        "build:all": "pnpm -r build",
        "ci:publish": "pnpm run build:all && pnpm changeset publish",
        "prepack:all": "pnpm -r prepack",
        "lint:all": "pnpm sync:snippets --check && pnpm -r lint",
        "lint:fix:all": "pnpm sync:snippets && pnpm -r lint:fix",
        "check:all": "pnpm -r typecheck && pnpm -r lint && pnpm run docs:check",
        "test:all": "pnpm -r test",
        "prepare": "npx --no-install lefthook install",
        "test:conformance:client": "pnpm --filter @modelcontextprotocol/test-conformance run test:conformance:client",
        "test:conformance:client:all": "pnpm --filter @modelcontextprotocol/test-conformance run test:conformance:client:all",
        "test:conformance:client:run": "pnpm --filter @modelcontextprotocol/test-conformance run test:conformance:client:run",
        "test:conformance:server": "pnpm --filter @modelcontextprotocol/test-conformance run test:conformance:server",
        "test:conformance:server:all": "pnpm --filter @modelcontextprotocol/test-conformance run test:conformance:server:all",
        "test:conformance:server:run": "pnpm --filter @modelcontextprotocol/test-conformance run test:conformance:server:run",
        "test:conformance:all": "pnpm run test:conformance:client:all && pnpm run test:conformance:server:all"
    },
    "dependencies": {
        "@cfworker/json-schema": "^4.1.1",
        "ajv": "^8.17.1",
        "ajv-formats": "^3.0.1",
        "cross-spawn": "^7.0.5",
        "eventsource": "^3.0.2",
        "eventsource-parser": "^3.0.0",
        "jose": "^6.1.3",
        "json-schema-typed": "^8.0.2",
        "pkce-challenge": "^5.0.0",
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "lefthook": "^2.0.16",
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.29.8",
        "@eslint/js": "^9.39.2",
        "@types/content-type": "^1.1.8",
        "@types/cors": "^2.8.17",
        "@types/cross-spawn": "^6.0.6",
        "@types/eventsource": "^1.1.15",
        "@types/express": "^5.0.6",
        "@types/express-serve-static-core": "^5.1.0",
        "@types/node": "^24.10.1",
        "@types/supertest": "^6.0.2",
        "@typescript/native-preview": "^7.0.0-dev.20251217.1",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-n": "^17.23.1",
        "fast-glob": "^3.3.3",
        "prettier": "3.6.2",
        "supertest": "^7.0.0",
        "tsdown": "^0.18.0",
        "tslib": "^2.8.1",
        "tsx": "^4.16.5",
        "typedoc": "^0.28.14",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.48.1",
        "vitest": "^4.0.15"
    },
    "resolutions": {
        "strip-ansi": "6.0.1"
    }
}
